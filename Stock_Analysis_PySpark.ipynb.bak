      "|2013-01-10 00:00:00|15.825225830078125|15.982717686557145| 15.58369440494101|15.977579029206623|601146000|  AAPL|\n",
      "|2013-01-11 00:00:00|15.728199005126953| 15.87994850018283|15.689504877681403| 15.74935904886981|350506800|  AAPL|\n",
      "|2013-01-14 00:00:00|15.167449951171875|15.341266798466512|   15.069507049126|15.195561636958859|734207600|  AAPL|\n",
      "|2013-01-15 00:00:00|14.688922882080078| 15.08401693092202|14.612140027272854| 15.06315878067057|876772400|  AAPL|\n",
