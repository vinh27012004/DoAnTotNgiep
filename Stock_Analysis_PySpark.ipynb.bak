    "df_pandas = df_processed.toPandas()\n",
    "df_pandas['time'] = pd.to_datetime(df_pandas['time'])\n",
    "\n",
    "print(f\"✓ Chuyển xong: {len(df_pandas):,d} rows\")\n",
    "\n",
    "# Chọn một vài cổ phiếu đại diện để vẽ biểu đồ\n",
