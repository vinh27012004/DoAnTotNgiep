     "text": [
      "[Stage 281:============================>                            (1 + 1) / 2]\r"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "✓ df_features sẵn sàng: 99,759 rows — label sẽ tạo riêng cho US/VN ở PHẦN 7\n"
     ]
    },
    {
